NODE_ENV=development
PORT=3000
# Required in production: long random strings
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=30
# Comma-separated; empty = any email can register as a student (dev only)
ALLOWED_STUDENT_EMAIL_DOMAINS=
# Admin account created on first start
ADMIN_EMAIL=admin@lanturn.local
ADMIN_PASSWORD=Admin@12345
# true = also create synthetic demo employers, students, jobs
SEED_DEMO=true
# Database file (SQLite via node:sqlite)
DB_FILE=./data/lanturn.db
UPLOAD_DIR=./data/uploads
# ---- AI layer ----
# Leave every key empty to run fully on the built-in rules engine (nothing breaks).
# AI_PROVIDER=auto uses every provider that has a key, in AI_PRIORITY order, falling through on failure.
# Or set one name: deepseek | kimi | nvidia | opencode | gemini | groq | openrouter | openai | anthropic | custom
AI_PROVIDER=auto
AI_PRIORITY=deepseek,kimi,nvidia,opencode,gemini,groq,openrouter,openai,anthropic,custom
DEEPSEEK_API_KEY=
MOONSHOT_API_KEY=
NVIDIA_API_KEY=
OPENCODE_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Any provider's model / base URL can be overridden, e.g. DEEPSEEK_MODEL=..., KIMI_MODEL=..., NVIDIA_BASE_URL=...
# Custom OpenAI-compatible server (Ollama, LM Studio, vLLM...):
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
AI_TIMEOUT_MS=30000
AI_DAILY_QUOTA=20
RESUME_MAX_CHARS=20000
# Shown to the career coach so advice fits your campus
COLLEGE_NAME=your college
