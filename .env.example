NODE_ENV=development
PORT=3000
# Required in production: long random strings
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=30
# Comma-separated; empty = any email can register as a student (dev only)
ALLOWED_STUDENT_EMAIL_DOMAINS=
# Admin account created on first start. In production the app refuses to boot with the public default below unless you
# set ALLOW_DEFAULT_ADMIN_PASSWORD=1 (throw-away demo only).
ADMIN_EMAIL=admin@lanturn.local
ADMIN_PASSWORD=Admin@12345
ALLOW_DEFAULT_ADMIN_PASSWORD=
# true = also create synthetic demo employers, students, jobs with a published password (Demo@12345).
# Production refuses to boot with SEED_DEMO=true unless ALLOW_DEMO_SEED=1.
SEED_DEMO=true
# Database file (SQLite via node:sqlite)
DB_FILE=./data/lanturn.db
UPLOAD_DIR=./data/uploads
# ---- AI layer ----
# Leave every key empty to run fully on the built-in rules engine (nothing breaks).
# AI_PROVIDER=auto uses every provider that has a key, in AI_PRIORITY order, falling through on failure.
# Or set one name: deepseek | kimi | nvidia | opencode | gemini | groq | openrouter | openai | anthropic | custom
AI_PROVIDER=auto
AI_PRIORITY=deepseek,kimi,nvidia,opencode,gemini,groq,openrouter,openai,anthropic,custom
DEEPSEEK_API_KEY=
MOONSHOT_API_KEY=
NVIDIA_API_KEY=
OPENCODE_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Any provider model / base URL can be overridden, e.g. NVIDIA_MODEL=modelA,modelB,modelC (comma list = fallback chain)
# Custom OpenAI-compatible server (Ollama, LM Studio, vLLM...):
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
CEREBRAS_API_KEY=
MISTRAL_API_KEY=
GITHUB_MODELS_TOKEN=
AI_TIMEOUT_MS=30000
# Free AI actions per user per day, per feature (chat, analysis, roadmap, tailor, interview, arena...).
AI_DAILY_QUOTA=20
# Wraps the vendor keys saved from the admin AI screen. Set it to its own long random string so rotating
# JWT_REFRESH_SECRET does not orphan them.
AI_VAULT_SECRET=
RESUME_MAX_CHARS=20000
# Search / ML sidecars: unset NLP_SERVICE_URL to use the local rules engine. DISABLE_NATIVE=1 ignores the C++ addon.
NLP_SERVICE_URL=
NLP_SERVICE_TOKEN=
NLP_TIMEOUT_MS=4000
DISABLE_NATIVE=
SEARCH_TIMEOUT_MS=2000
# Shown to the career coach so advice fits your campus
COLLEGE_NAME=your college
# Timezone offset (minutes) used when deciding "today" for quotas, streaks and job alerts.
APP_TZ_OFFSET_MIN=330

# ---- Which UI gets served ----
# false (default) = the shipped vanilla SPA in ./public, no build step. true = the experimental React app in
# ./frontend, which must be built first (cd frontend && npm ci && npm run build).
USE_REACT=false
# Public base URL, used in emails, reset links, sitemap and the manifest.
PUBLIC_URL=http://localhost:3000

# ---- Security / proxy ----
# Number of reverse-proxy hops in front of the app (Render/Railway = 1, Cloudflare in front = 2, direct = false).
# Wrong values let clients spoof X-Forwarded-For and dodge rate limits.
TRUST_PROXY=
# bcrypt cost. 11 is ~180ms per hash; raise it as hardware gets faster.
BCRYPT_ROUNDS=11
# How long a just-rotated refresh token may be replayed before it counts as a stolen-token replay.
REFRESH_REUSE_GRACE_MS=60000
# Never set this in production.
DISABLE_RATE_LIMIT=

# ---- Email (optional). Without both values, reset links are printed to the server log and nothing is emailed.
EMAIL_API_KEY=
EMAIL_FROM=
EMAIL_API_URL=
# ---- Observability / backups (all optional)
SENTRY_DSN=
ALERT_WEBHOOK_URL=
UPTIME_PING_URL=
BACKUP_DIR=
BACKUP_KEEP=7

# Live job boards (optional). Adzuna: free keys at developer.adzuna.com. Jooble: free key at jooble.org/api/about
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=in
JOOBLE_API_KEY=
