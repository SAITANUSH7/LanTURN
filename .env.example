NODE_ENV=development
PORT=3000
# Required in production: long random strings
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=30
# Comma-separated; empty = any email can register as a student (dev only)
ALLOWED_STUDENT_EMAIL_DOMAINS=
# Admin account created on first start
ADMIN_EMAIL=admin@lanturn.local
ADMIN_PASSWORD=Admin@12345
# true = also create synthetic demo employers, students, jobs
SEED_DEMO=true
# Database file (SQLite via node:sqlite)
DB_FILE=./data/lanturn.db
UPLOAD_DIR=./data/uploads
# AI layer: leave LLM_MODEL empty to run fully on the built-in rules engine
ANTHROPIC_API_KEY=
LLM_MODEL=
AI_DAILY_QUOTA=20
RESUME_MAX_CHARS=20000
