{
  "name": "lanturn",
  "version": "1.0.0",
  "description": "LanTURN: AI-powered career and placement platform (Node.js + Express + vanilla HTML/CSS/JS)",
  "private": true,
  "main": "server.js",
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "start": "node --no-warnings server.js",
